# Rust build output.
target/

# Terraform - never commit provider cache, state, or host-identifying tfvars.
.terraform/
*.tfstate
*.tfstate.*

# Variable files can hold host-specific values (AGENTS.md "Code style"); real
# values stay behind variables, so commit *.tfvars.example instead.
*.tfvars
*.tfvars.json

# Terraform crash logs and local overrides.
crash.log
crash.*.log
override.tf
override.tf.json

# Saved plan files. A plan embeds the full before/after of every resource,
# including values that state holds, so it is never a thing to commit.
tfplan
*.tfplan
tfplan.*

# macOS desktop metadata.
.DS_Store

#!/usr/bin/env bash
# Fast checks on what is being committed: shellcheck and ksh -n on the staged
# scripts, rustfmt --check on the crates when Rust is staged. CI runs the full
# set; this catches the failures that used to reach it and be found there.
#
# bash, not sh, for `read -d`: the staged names arrive NUL-separated, so a path
# holding a space, quote or backslash is one name. On the newline-separated list
# git C-quotes such a path, and a quoted name is not a path: the check skipped it.
set -e
cd "$(git rev-parse --show-toplevel)"
# A build artifact is never source. Rejecting every added binary keeps a compiled
# test helper out of the public tree; `.gitignore` also names the ones this repo
# builds, so this only fires on a path nobody expected to be binary.
binaries=$(git diff --cached --numstat --diff-filter=ACM | awk '$1 == "-" { print $3 }')
if [ -n "$binaries" ]; then
	printf 'pre-commit: refusing binary file(s):\n%s\n' "$binaries" >&2
	exit 1
fi
# A shell script is a staged *.sh or a staged file whose first line is a shell
# shebang: the ksh programs under openbsd/etc carry no suffix. Each path is
# passed quoted, so it is one argument whatever characters it holds.
is_script() {
	case "$1" in
	*.sh) return 0 ;;
	esac
	case "$(head -n 1 -- "$1" 2>/dev/null)" in
	'#!'*sh | '#!'*sh\ *) return 0 ;;
	esac
	return 1
}
scripts=()
rust=0
while IFS= read -r -d '' f; do
	case "$f" in *.rs) rust=1 ;; esac
	if [ -f "$f" ] && is_script "$f"; then scripts+=("$f"); fi
done < <(git diff --cached --name-only -z --diff-filter=ACM)
if [ ${#scripts[@]} -gt 0 ]; then
	if ! command -v shellcheck >/dev/null 2>&1; then
		printf 'pre-commit: shellcheck is not on PATH; install it, or commit with --no-verify\n' >&2
		exit 1
	fi
	for s in "${scripts[@]}"; do
		shellcheck "$s"
		if command -v ksh >/dev/null 2>&1; then
			ksh -n "$s"
		fi
	done
fi
if [ "$rust" = 1 ]; then
	for crate in control kyriakon-encrypt; do
		[ -f "$crate/Cargo.toml" ] || continue
		cargo fmt --manifest-path "$crate/Cargo.toml" --all --check
	done
fi

#!/bin/sh
# Refuse a push from a branch that is behind origin/main. A branch cut before a
# merge squashes to a commit that silently reverts that merge, which is how #429
# was undone once.
set -e
while read -r _local_ref local_sha remote_ref _remote_sha; do
	case "$remote_ref" in refs/heads/main) continue ;; esac
	case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
	behind=$(git rev-list --count "$local_sha..origin/main" 2>/dev/null || printf '0')
	if [ "${behind:-0}" -gt 0 ]; then
		printf 'pre-push: %s is %s commit(s) behind origin/main; merge origin/main into it, then push.\n' "$remote_ref" "$behind" >&2
		exit 1
	fi
done

# Kyriakon box values.
#
# deploy-mail.sh installs this to /root/.kyriakon-env, mode 0600, if that file
# does not exist yet; it is never rewritten once it does, because the real values
# live there and this copy carries placeholders. The deploy, nsd, backup, restore
# and rehearsal scripts source it, and the cron lines source it too, so nothing
# has to be retyped or passed on a command line.
#
# Every line is an `export`, which is what lets the cron lines source the file
# directly and keeps the alert topic and ping URLs out of the crontab.
#
# Nothing secret belongs in this file as tracked: it is public. Fill in the
# installed copy at /root/.kyriakon-env.

# This box. deploy-nsd.sh substitutes these into the zone and then verifies the
# result against ifconfig, so a wrong value fails loudly rather than publishing an
# A record that answers nothing.
export KYRIAKON_IPV4='REPLACE_ME_IPV4'
export KYRIAKON_IPV6='REPLACE_ME_IPV6'

# The HMAC-SHA256 key Hurricane Electric signs its AXFR requests with, under the
# fixed key name kyriakon-he. Generate one with `openssl rand -base64 32`, or
# paste what HE generated; the same value has to be set on the HE portal's slave
# entry for kyriakon.net. Without it, signed transfers fail and the secondaries
# serve whatever they last held.
export KYRIAKON_TSIG_SECRET='REPLACE_ME'

# Backups. The password is a separate mode-0600 file rather than a value here,
# which is the shape backup.sh and restore-test.sh expect.
export RESTIC_REPOSITORY='sftp://REPLACE_ME_USER@REPLACE_ME_HOST:23/kyriakon-backup'
export RESTIC_PASSWORD_FILE='/root/.restic-pass'

# Alerts. ALERT_TOPIC is an ntfy.sh topic, and anyone who knows it can read and
# post to it, so treat it as a secret. HEALTHCHECKS_URL is this box's dead-man's
# switch. REHEARSAL_HEALTHCHECKS_URL belongs to the quarterly rehearsal check and
# is needed on the throwaway box, not on this one.
export ALERT_TOPIC='REPLACE_ME_NTFY_TOPIC'
export HEALTHCHECKS_URL='REPLACE_ME_HEALTHCHECKS_URL'
export REHEARSAL_HEALTHCHECKS_URL='REPLACE_ME_REHEARSAL_HEALTHCHECKS_URL'

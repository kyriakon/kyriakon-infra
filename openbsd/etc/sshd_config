#	$OpenBSD: sshd_config,v 1.105 2024/12/03 14:12:47 dtucker Exp $

# Kyriakon: a copy of the live box's file, not a starting point to diff. Every
# difference from /etc/ssh/sshd_config is in this header, checked on 2026-09-21.
# It is OpenBSD's shipped file, v1.105 in 7.9, which the release trims from the
# upstream one, so a newer upstream copy is not a substitute.

# Three changes here depart from the stock file. All are deliberate: the two
# hardening settings below, and the member-hosting fragment at the end.
#
# Nothing on this box can authenticate by password. The operator account is in
# wheel and has doas, so a guessed password would be root on the mail host, and
# this host takes thousands of named-account guesses a day. Password and
# keyboard-interactive are both off; keyboard-interactive matters because it
# defaults to on and would otherwise offer the same guessing surface under
# another name. Keys are unaffected, and doas still prompts for the local
# password, which sshd never sees.
#
# ClientAliveInterval 30 with ClientAliveCountMax 6 drops a session whose far end
# has stopped answering after about three minutes, a laptop that went to sleep, for
# instance. Set here rather than left at OpenSSH's default of no probing, so a
# connection nobody is on the other end of does not sit open. A client that is
# still there answers the probes, so long-running commands are unaffected.
#
# The member fragment adds port 2222 and the two Match blocks at the end of the
# file. A member uploads with sftp and pushes to pass repositories with git-shell
# from one account and one key, and ChrootDirectory applies to every session of a
# user, so the two cannot share a chroot: a chrooted session has no
# /usr/local/bin/git-shell inside it, and OpenBSD has no nullfs to lend it one.
# sshd separates them by port instead. sftp keeps the default port 22, where
# ForceCommand internal-sftp is handled inside sshd before the login shell is
# exec'd; git-shell stays on 2222, unchrooted.
#
# Both blocks were checked against the live binary on 2026-10-01, with a
# throwaway host key under /tmp and no change to the box: `sshd -T -f <fragment>
# -h <throwaway key> -C user=oliver,lport=22` reports chrootdirectory
# /home/www/%u.kyriakon.net and forcecommand "internal-sftp -u 0022", the same
# check with lport=2222 reports chrootdirectory none and forcecommand none, and a
# port matching neither block (lport=23) also reports none. The %u token is left
# unexpanded by -T; sshd expands it when the session starts. The test account was
# in wheel rather than members, because no members group exists yet.
#
# Applied by hand, never by a deploy: this file is reviewed line by line.
#
#   doas sshd -t && doas kill -HUP "$(cat /var/run/sshd.pid)"

# This is the sshd server system-wide configuration file.  See
# sshd_config(5) for more information.

# The strategy used for options in the default sshd_config shipped with
# OpenSSH is to specify options with their default value where
# possible, but leave them commented.  Uncommented options override the
# default value.

# The member-hosting port split needs both ports named: once any Port directive
# is present, sshd listens on exactly those and ignores the compiled-in default.
# 22 keeps the upload path on the default port, so a member never types a port to
# put a site up; 2222 carries the git-shell sessions for pass repositories and is
# opened in pf.
Port 22
Port 2222
#AddressFamily any
#ListenAddress 0.0.0.0
#ListenAddress ::

#HostKey /etc/ssh/ssh_host_rsa_key
#HostKey /etc/ssh/ssh_host_ecdsa_key
#HostKey /etc/ssh/ssh_host_ed25519_key

# Ciphers and keying
#RekeyLimit default none

# Logging
#SyslogFacility AUTH
#LogLevel INFO

# Authentication:

#LoginGraceTime 2m
PermitRootLogin no
#StrictModes yes
#MaxAuthTries 6
#MaxSessions 10

#PubkeyAuthentication yes

# The default is to check both .ssh/authorized_keys and .ssh/authorized_keys2
# but this is overridden so installations will only check .ssh/authorized_keys
AuthorizedKeysFile	.ssh/authorized_keys

#AuthorizedPrincipalsFile none

#AuthorizedKeysCommand none
#AuthorizedKeysCommandUser nobody

# For this to work you will also need host keys in /etc/ssh/ssh_known_hosts
#HostbasedAuthentication no
# Change to yes if you don't trust ~/.ssh/known_hosts for
# HostbasedAuthentication
#IgnoreUserKnownHosts no
# Don't read the user's ~/.rhosts and ~/.shosts files
#IgnoreRhosts yes

# To disable tunneled clear text passwords, change to "no" here!
PasswordAuthentication no
#PermitEmptyPasswords no

# Change to "no" to disable keyboard-interactive authentication.  Depending on
# the system's configuration, this may involve passwords, challenge-response,
# one-time passwords or some combination of these and other methods.
KbdInteractiveAuthentication no

#AllowAgentForwarding yes
#AllowTcpForwarding yes
#GatewayPorts no
#X11Forwarding no
#X11DisplayOffset 10
#X11UseLocalhost yes
#PermitTTY yes
#PrintMotd yes
#PrintLastLog yes
#TCPKeepAlive yes
#PermitUserEnvironment no
#Compression delayed
ClientAliveInterval 30
ClientAliveCountMax 6
#UseDNS no
#PidFile /var/run/sshd.pid
#MaxStartups 10:30:100
#PermitTunnel no
#ChrootDirectory none
#VersionAddendum none

# no default banner path
#Banner none

# override default of no subsystems
Subsystem	sftp	/usr/libexec/sftp-server

# Example of overriding settings on a per-user basis
#Match User anoncvs
#	X11Forwarding no
#	AllowTcpForwarding no
#	PermitTTY no
#	ForceCommand cvs server

# --- member hosting ---------------------------------------------------------
#
# The members group holds member accounts and nothing else, so both blocks below
# apply to members only. The group is set at signup, and it is also the switch
# that turns the restrictions on: an account left out of it keeps an
# unrestricted shell if its shell is ever set to one, which is why membership is
# a provisioning step rather than a later hardening pass.
#
# The first block is the shared hardening and has to come first. When two Match
# blocks both apply, sshd applies the first instance of each keyword and ignores
# the later one, so every keyword both blocks need belongs here.
#
# The second block is the chrooted upload session, on 22 only. Its root is the
# member's public directory, /home/www/<name>.kyriakon.net, which contains www/
# and gemini/ and nothing else: Maildir and repos stay under /home/<name>,
# outside everything this session can reach. sshd checks the chroot root and
# every component above it for root ownership and no group or other write bit
# (safely_chroot in session.c), so the signup path leaves that directory
# root:wheel 0755 and gives the two subdirectories to the member.
#
# There is deliberately no LocalPort 2222 block. 2222 is where the member's
# session shell runs, and that shell is /usr/local/bin/git-shell, so a push
# arrives as `git-shell -c '<client command>'`. A ForceCommand there would
# replace the client's command and break the push, and a ChrootDirectory would
# put git-shell outside the filesystem.
#
# That shell is not in the password entry, which goes on carrying /sbin/nologin.
# It comes from the member login class: /etc/login.conf.d/member carries
# `shell=/usr/local/bin/git-shell`, and provisioning assigns it with
# `usermod -L member <name>`. sshd takes the session shell from there, since
# auth.c sets lc = login_getclass(pw->pw_class) and session.c's do_child() takes
# shell = login_getcapstr(lc, "shell", pw_shell, pw_shell) before it execs
# anything. So the account keeps no shell of its own and still pushes on 2222,
# and an account whose class has not been assigned has nologin there instead,
# because nologin ignores -c and exits. The port 22 upload is unaffected either
# way: its forced internal-sftp is run in process, before the shell is read.
Match Group members
	AuthenticationMethods publickey
	DisableForwarding yes
	PermitTTY no

Match Group members LocalPort 22
	ChrootDirectory /home/www/%u.kyriakon.net
	ForceCommand internal-sftp -u 0022
